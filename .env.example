# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Metrics Collection
COLLECTION_INTERVAL=60

# Striim Configuration (configured via UI)
# STRIIM_URL=http://localhost:9080
# STRIIM_USER=admin
# STRIIM_PASSWORD=your-password

# ====================
# Splunk Configuration
# ====================
#
# FOR DEVELOPMENT (using docker-compose.dev.yml):
# - Splunk auto-initializes with index and token
# - Use: http://splunk:8088/services/collector (inside Docker network)
# - Or: http://localhost:8088/services/collector (from host machine)
# - Token is auto-generated and printed to console
#
# FOR PRODUCTION:
# - Set up Splunk manually (see SPLUNK_SETUP.md)
# - Use your production Splunk instance URL
# - Use your production HEC token
#
# See SPLUNK_SETUP.md for detailed instructions

# Development Configuration (auto-generated by docker-compose.dev.yml)
# Uncomment to override auto-generated values
# SPLUNK_HEC_URL=http://splunk:8088/services/collector
# SPLUNK_TOKEN=your-hec-token-here
# SPLUNK_INDEX=striim_metrics

# Production Configuration Example
# SPLUNK_HEC_URL=https://splunk.company.com:8088/services/collector
# SPLUNK_TOKEN=your-production-hec-token
# SPLUNK_INDEX=striim_metrics
