# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Metrics Collection
COLLECTION_INTERVAL=60

# Striim Configuration (configured via UI)
# STRIIM_URL=http://localhost:9080
# STRIIM_USER=admin
# STRIIM_PASSWORD=your-password

# Splunk Configuration (configured via UI)
# SPLUNK_HEC_URL=https://splunk.company.com:8088/services/collector
# SPLUNK_TOKEN=your-token
# SPLUNK_INDEX=striim_metrics
