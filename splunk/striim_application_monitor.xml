<?xml version="1.0" encoding="UTF-8"?>
<form version="1.1">
  <label>Striim Application Monitor</label>
  <description>Monitor Striim applications status and metrics from mon command output</description>

  <!-- Time Range Picker -->
  <fieldset submitButton="true" autoRun="true">
    <input type="time" token="time_picker">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <!-- Row 1: Key Metrics -->
  <row>
    <panel>
      <title>Running Applications</title>
      <single>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| spath path=metric_0.runningApplications output=running_count
| stats latest(running_count) as count
| fields count</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="underLabel">Apps</option>
        <option name="useThousandSeparators">1</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x65A637","0xF7BC38","0xF58F39","0xD93F3C"]</option>
        <option name="rangeValues">[0,5,10]</option>
      </single>
    </panel>
    <panel>
      <title>Stopped Applications</title>
      <single>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| spath path=metric_0.stoppedApplications output=stopped_count
| stats latest(stopped_count) as count
| fields count</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="underLabel">Apps</option>
        <option name="useThousandSeparators">1</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x65A637","0xF7BC38","0xF58F39","0xD93F3C"]</option>
        <option name="rangeValues">[0,2,5]</option>
      </single>
    </panel>
    <panel>
      <title>Created Applications</title>
      <single>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| spath path=metric_0.createdApplications output=created_count
| stats latest(created_count) as count
| fields count</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="underLabel">Apps</option>
        <option name="useThousandSeparators">1</option>
      </single>
    </panel>
    <panel>
      <title>Total Applications</title>
      <single>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| spath path=metric_0.totalApplications output=total_count
| stats latest(total_count) as total_count
| fields total_count</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="underLabel">Apps</option>
        <option name="useThousandSeparators">1</option>
      </single>
    </panel>
  </row>

  <!-- Row 2: Status Distribution -->
  <row>
    <panel>
      <title>Application Status Distribution</title>
      <chart>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| spath path=metric_0.applications{} output=apps
| mvexpand apps
| spath input=apps path=name output=app_name
| spath input=apps path=status output=status
| dedup app_name
| stats count by status</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.chart.sliceLabels">["status","count"]</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
    <panel>
      <title>Status Breakdown</title>
      <table>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| spath path=metric_0.applications{} output=apps
| mvexpand apps
| spath input=apps path=name output=app_name
| spath input=apps path=status output=Status
| dedup app_name
| stats count by Status
| eval "Percentage"=round((count/sum(count))*100,2)."%"
| rename count as "Total Count"</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">10</option>
        <format type="color" field="Status">
          <colorPalette type="map">{"RUNNING": "#65A637", "STOPPED": "#D93F3C", "CREATED": "#1565C0", "HALT": "#FF9900", "TERMINATED": "#999999", "COMPLETED": "#28A745", "NOT_ENOUGH_SERVERS": "#FFC107"}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <!-- Row 3: Applications Status Table -->
  <row>
    <panel>
      <title>All Applications Status</title>
      <table>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| spath path=metric_0.applications{} output=apps
| mvexpand apps
| spath input=apps path=name output="Application Name"
| spath input=apps path=status output="Status"
| spath input=apps path=rate output="Rate"
| spath input=apps path=numServers output="Servers"
| spath input=apps path=latestActivity output="Latest Activity"
| dedup "Application Name"
| table "Application Name", "Status", "Rate", "Servers", "Latest Activity"
| sort - "Status"</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">50</option>
        <option name="wrap">true</option>
        <format type="color" field="Status">
          <colorPalette type="map">{"RUNNING": "#65A637", "STOPPED": "#D93F3C", "CREATED": "#1565C0", "HALT": "#FF9900", "TERMINATED": "#999999", "COMPLETED": "#28A745", "NOT_ENOUGH_SERVERS": "#FFC107"}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <!-- Row 4: Collection Timeline -->
  <row>
    <panel>
      <title>Metrics Collection Timeline</title>
      <chart>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| timechart count as "Collection Count"</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleY.text">Collection Count</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>

  <!-- Row 5: Recent Events -->
  <row>
    <panel>
      <title>Recent Metrics Events (Raw JSON)</title>
      <table>
        <search>
          <query>index=striim_app_mon sourcetype=_json
| fields _time, _raw
| head 10
| sort - _time</query>
          <earliest>$time_picker.earliest$</earliest>
          <latest>$time_picker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">10</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

</form>
